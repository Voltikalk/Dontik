# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Groq API Key (получить на https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Список Telegram ID пользователей, которым разрешен доступ к боту (через запятую).
# Оставьте пустым для публичного доступа. Узнать свой ID можно через @userinfobot
ALLOWED_TELEGRAM_IDS=123456789,987654321

# Путь к базе данных SQLite
DATABASE_URL=sqlite+aiosqlite:///data/garage.db

# Модели Groq
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
