# ─── Обязательное ────────────────────────────────────────────────────────────

# Токен бота от @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Ключ Groq API (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Белый список Telegram ID через запятую.
# Пусто = бот доступен всем (небезопасно). Свой ID — через @userinfobot.
ALLOWED_TELEGRAM_IDS=123456789,987654321


# ─── База данных ─────────────────────────────────────────────────────────────

DATABASE_URL=sqlite+aiosqlite:///data/garage.db


# ─── Модели Groq ─────────────────────────────────────────────────────────────

# Основная модель для ответов. Запасные модели (gpt-oss-20b, qwen) подставляются
# автоматически, если основная недоступна или перегружена.
GROQ_MODEL=openai/gpt-oss-120b

# Модель распознавания речи
GROQ_WHISPER_MODEL=whisper-large-v3-turbo


# ─── Почта (необязательно) ───────────────────────────────────────────────────
# Нужен пароль приложения, а не основной пароль почты.
# Mail.ru / Яндекс / Gmail: Настройки → Безопасность → Пароли для внешних приложений

EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465